op_name: "airspace_matcher"

# Input[0]: dmask [1] (int32)
input {
  id: "dmask"
  shape: {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value: {
    value_i: 255
  }
}

# Input[1]: gridEnvCode [gridSize=4] (int32)
input {
  id: "gridEnvCode"
  shape: {
    dims: 4
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value: {
    value_i: 9
    value_i: 8
    value_i: 7
    value_i: 16
  }
}

# Input[2]: aircraftEnvCode [1] (int32)
input {
  id: "aircraftEnvCode"
  shape: {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value: {
    value_i: 8
  }
}

# Output[0]: outFlag [gridSize=4] (int16)
output {
  id: "outFlag"
  shape: {
    dims: 4
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT16
  ttype: TENSOR
}

tecokernel_param: {
  airspace_matcher_param: {
    is_data_compression: true
  }
}
