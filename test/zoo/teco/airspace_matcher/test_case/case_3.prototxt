op_name: "airspace_matcher"

# Input[0]: dmask [1] (int32)
input {
  id: "dmask"
  shape: {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value: {
    value_i: 65535
  }
}

# Input[1]: gridEnvCode [gridSize=10000000] (int32, random)
input {
  id: "gridEnvCode"
  shape: {
    dims: 10000000
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  random_data: {
    seed: 42
    lower_bound: -100000
    upper_bound: 1000000
    distribution: UNIFORM
  }
}

# Input[2]: aircraftEnvCode [1] (int32)
input {
  id: "aircraftEnvCode"
  shape: {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT32
  ttype: TENSOR
  prev_value: {
    value_i: 500000
  }
}

# Output[0]: outFlag [gridSize=10000000] (int16)
output {
  id: "outFlag"
  shape: {
    dims: 10000000
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT16
  ttype: TENSOR
}

tecokernel_param: {
  airspace_matcher_param: {
    is_data_compression: true
  }
}
